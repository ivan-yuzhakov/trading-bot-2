{
  "name": "Iter1: RSI+Bollinger Scalp",
  "backtest": {
    "startDate": "2026-01-01",
    "endDate": "2026-03-31",
    "initialBalance": "10000"
  },
  "strategy": {
    "pair": "ETHUSDT",
    "exchange": "binance",
    "analyzers": [
      {
        "name": "rsi",
        "timeframe": "5m",
        "weight": "1.0",
        "config": {
          "period": 14,
          "oversold": { "from": 25, "to": 35, "step": 5 },
          "overbought": 95
        }
      },
      {
        "name": "bollinger",
        "timeframe": "5m",
        "weight": "1.0",
        "config": {
          "period": 20,
          "stdDev": 2
        }
      },
      {
        "name": "profit_target",
        "weight": "5.0",
        "config": {
          "targetPct": { "from": 1, "to": 4, "step": 0.5 }
        }
      },
      {
        "name": "stop_loss",
        "weight": "5.0",
        "config": {
          "lossPct": { "from": 1, "to": 3, "step": 0.5 }
        }
      }
    ],
    "buy_threshold": { "from": 0.3, "to": 0.7, "step": 0.1 },
    "sell_threshold": "0.5",
    "stop_loss_pct": null,
    "money_management": {
      "mode": "percentage",
      "amount": "95",
      "maxConcurrentTrades": 1,
      "maxExposurePerPair": "10000",
      "dailyLossLimit": "0"
    }
  }
}
